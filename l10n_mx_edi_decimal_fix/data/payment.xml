<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- The amounts are computed in _l10n_mx_edi_add_payment_cfdi_values: print
         them with the SAT decimals even when the currency is configured with
         more. The Totales already use mxn_digits. -->
    <template id="payment20_precision2" inherit_id="l10n_mx_edi.payment20">
        <!-- Pago -->
        <xpath
            expr="//*[local-name()='Pago' and namespace-uri()='http://www.sat.gob.mx/Pagos20']"
            position="attributes"
        >
            <attribute
                name="t-att-Monto"
            >format_float(payment['monto'], precision=2)</attribute>
        </xpath>

        <!-- DoctoRelacionado -->
        <xpath
            expr="//*[local-name()='DoctoRelacionado' and namespace-uri()='http://www.sat.gob.mx/Pagos20']"
            position="attributes"
        >
            <attribute
                name="t-att-ImpSaldoAnt"
            >invoice_values['format_float'](invoice_values['imp_saldo_ant'], precision=2)</attribute>
            <attribute
                name="t-att-ImpPagado"
            >invoice_values['format_float'](invoice_values['imp_pagado'], precision=2)</attribute>
            <attribute
                name="t-att-ImpSaldoInsoluto"
            >invoice_values['format_float'](invoice_values['imp_saldo_insoluto'], precision=2)</attribute>
        </xpath>

        <!-- RetencionDR / TrasladoDR -->
        <xpath
            expr="//*[local-name()='RetencionDR' and namespace-uri()='http://www.sat.gob.mx/Pagos20']"
            position="attributes"
        >
            <attribute
                name="t-att-BaseDR"
            >invoice_values['format_float'](tax_values['base'], precision=2)</attribute>
            <attribute
                name="t-att-ImporteDR"
            >invoice_values['format_float'](tax_values['importe'], precision=2)</attribute>
        </xpath>
        <xpath
            expr="//*[local-name()='TrasladoDR' and namespace-uri()='http://www.sat.gob.mx/Pagos20']"
            position="attributes"
        >
            <attribute
                name="t-att-BaseDR"
            >invoice_values['format_float'](tax_values['base'], precision=2)</attribute>
            <attribute
                name="t-att-ImporteDR"
            >invoice_values['format_float'](tax_values['importe'], precision=2)</attribute>
        </xpath>

        <!-- RetencionP / TrasladoP: Finkok compares BaseP/ImporteP with the sum of
             the DR amounts divided by EquivalenciaDR rounded to 6 decimals, and
             rejects both a 2dp value when the quotient has more decimals
             (CRP20268/CRP20274) and trailing zeros beyond the decimals of
             MonedaP (CRPER654): "20634.526572", "18796.71875" and "28200.00"
             are accepted; "20634.52", "18796.718750" and "28200.000000" are
             not. -->
        <xpath
            expr="//*[local-name()='RetencionP' and namespace-uri()='http://www.sat.gob.mx/Pagos20']"
            position="attributes"
        >
            <attribute
                name="t-att-ImporteP"
            >format_float(tax_values['importe'], precision=6, min_precision=2)</attribute>
        </xpath>
        <xpath
            expr="//*[local-name()='TrasladoP' and namespace-uri()='http://www.sat.gob.mx/Pagos20']"
            position="attributes"
        >
            <attribute
                name="t-att-BaseP"
            >format_float(tax_values['base'], precision=6, min_precision=2)</attribute>
            <attribute
                name="t-att-ImporteP"
            >format_float(tax_values['importe'], precision=6, min_precision=2)</attribute>
        </xpath>
    </template>
</odoo>
